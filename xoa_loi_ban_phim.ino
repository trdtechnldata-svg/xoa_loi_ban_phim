void read_data_pin_24()  // doc data LFP
{

  if (ESP32Can.readFrame(rxFrame, 11)) {
    if (rxFrame.identifier == 0x309) {
      a4 = rxFrame.data[4];
      a5 = rxFrame.data[5];
      a6 = rxFrame.data[6];
      a7 = rxFrame.data[7];
      ampe_charge = (word(a6, a7)) * 2 * 0.01;
    }
    if (rxFrame.identifier == 0x310) {
      var1_1 = rxFrame.data[1];
      var2_1 = rxFrame.data[0];
      var1_2 = rxFrame.data[3];
      var2_2 = rxFrame.data[2];
      var1_3 = rxFrame.data[5];
      var2_3 = rxFrame.data[4];
      var1_4 = rxFrame.data[7];
      var2_4 = rxFrame.data[6];
    }
  }

  if (ESP32Can.readFrame(rxFrame, 11)) {
    if (rxFrame.identifier == 0x30A) {
      var1_31 = rxFrame.data[1];
      var2_31 = rxFrame.data[0];
      var1_32 = rxFrame.data[3];
      var2_32 = rxFrame.data[2];
