      var_100 = rxFrame.data[1];
      var_101 = rxFrame.data[0];
      var_102 = rxFrame.data[3];
      // var_103 =  rxFrame.data[2];
    }
    if (rxFrame.identifier == 0x30E)  // nhiet do pin
    {
      var1_27 = rxFrame.data[1];
      var2_27 = rxFrame.data[0];
      var1_28 = rxFrame.data[3];
      var2_28 = rxFrame.data[2];
      var1_29 = rxFrame.data[5];
      var2_29 = rxFrame.data[4];
      var1_30 = rxFrame.data[7];
      var2_30 = rxFrame.data[6];
    }
  }

  if (ESP32Can.readFrame(rxFrame, 11)) {
    if (rxFrame.identifier == 0x311)  // nhiet do pin
    {
      var1_5 = rxFrame.data[1];
      var2_5 = rxFrame.data[0];
      var1_6 = rxFrame.data[3];
      var2_6 = rxFrame.data[2];
      var1_7 = rxFrame.data[5];
      var2_7 = rxFrame.data[4];
      var1_8 = rxFrame.data[7];
      var2_8 = rxFrame.data[6];
    }
    if (rxFrame.identifier == 0x312)  // nhiet do pin
    {
      var1_9 = rxFrame.data[1];
      var2_9 = rxFrame.data[0];
      var1_10 = rxFrame.data[3];
      var2_10 = rxFrame.data[2];
      var1_11 = rxFrame.data[5];
      var2_11 = rxFrame.data[4];
      var1_12 = rxFrame.data[7];
      var2_12 = rxFrame.data[6];
    }
    if (rxFrame.identifier == 0x313) {
      var1_13 = rxFrame.data[1];
      var2_13 = rxFrame.data[0];
      var1_14 = rxFrame.data[3];
      var2_14 = rxFrame.data[2];
      var1_15 = rxFrame.data[5];
      var2_15 = rxFrame.data[4];
      var1_16 = rxFrame.data[7];
      var2_16 = rxFrame.data[6];
    }
  }


  v_max_lfp = word(var1_3, var2_4);
  v_min_lfp = word(var_31b_2, var_31b_3);


  if (ESP32Can.readFrame(rxFrame, 11)) {

    if (rxFrame.identifier == 0x314) {
      var1_17 = rxFrame.data[1];
