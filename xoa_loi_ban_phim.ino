  memset(can_buffer,0,sizeof(can_buffer)); memset(scanner_order,0,sizeof(scanner_order));
  scanner_count=0; scanner_dirty_rows=0; scanner_top=0; scanner_touch_mode=0;
  scanner_view_dirty=true; scanner_last_draw=millis()-80;
  scanner_shown_total=-1; scanner_limit_reached=scanner_shown_limit=false;
