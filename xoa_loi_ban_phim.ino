// Native Scanner: reuse the screen and left-hand buttons; no table/cell objects.
static uint8_t scanner_order[MAX_CAN_IDS];
static uint8_t scanner_count;
static uint64_t scanner_dirty_rows;
static uint32_t scanner_last_draw;
static int scanner_shown_total = -1;
static bool scanner_limit_reached, scanner_shown_limit;
static const uint32_t SCANNER_RX_BUDGET_US = 1500;
static const unsigned SCANNER_RX_MAX_FRAMES = 32;
static const unsigned SCANNER_VISIBLE_ROWS = 9;
static int scanner_top;
static bool scanner_view_dirty;
static unsigned scanner_touch_mode;
static int scanner_touch_y, scanner_touch_top;
static uint32_t scanner_repeat_at;

static int scanner_max_top() {
  return scanner_count > SCANNER_VISIBLE_ROWS ? scanner_count - SCANNER_VISIBLE_ROWS : 0;
}
static void scanner_scroll(int top) {
  if (top < 0) top = 0;
  if (top > scanner_max_top()) top = scanner_max_top();
  if (top != scanner_top) { scanner_top = top; scanner_view_dirty = true; }
}
extern "C" bool can_scanner_capture_touch(uint16_t x, uint16_t y, bool pressed) {
  if (xoa != 88) { scanner_touch_mode = 0; return false; }
  if (!pressed) { bool taken = scanner_touch_mode != 0; scanner_touch_mode = 0; return taken; }
  if (!scanner_touch_mode) {
    // The original Total/BACK controls at x<96,y>=196 keep normal LVGL input.
    if (x < 96 && y >= 196) return false;
    scanner_touch_y = y; scanner_touch_top = scanner_top;
    if (x >= 96) scanner_touch_mode = 1;
    else if (y < 60) { scanner_touch_mode = 3; scanner_scroll(scanner_top - 1); }
    else if (y >= 146) { scanner_touch_mode = 4; scanner_scroll(scanner_top + 1); }
    else scanner_touch_mode = 2;
    scanner_repeat_at = millis();
  }
  if (scanner_touch_mode == 1) scanner_scroll(scanner_touch_top + (scanner_touch_y - (int)y) / 30);
  else if (scanner_touch_mode == 2) scanner_scroll(((int)y - 76) * scanner_max_top() / 52);
  else if ((uint32_t)(millis() - scanner_repeat_at) >= 250) {
    scanner_scroll(scanner_top + (scanner_touch_mode == 3 ? -1 : 1));
    scanner_repeat_at = millis();
  }
  return true;
}
static void scanner_box(lv_draw_ctx_t *ctx, const lv_area_t &root, int x, int y, int w, int h, uint32_t color) {
  lv_draw_rect_dsc_t d; lv_draw_rect_dsc_init(&d);
  d.bg_color = lv_color_hex(color); d.bg_opa = LV_OPA_COVER;
  d.border_width = 0; d.radius = 0;
  lv_area_t area = {(lv_coord_t)(root.x1+x),(lv_coord_t)(root.y1+y),(lv_coord_t)(root.x1+x+w-1),(lv_coord_t)(root.y1+y+h-1)};
  lv_draw_rect(ctx, &d, &area);
}
static void scanner_text(lv_draw_ctx_t *ctx, const lv_area_t &root, int x, int y, int w, int h, const char *text, uint32_t color, bool center = false) {
  lv_area_t cell = {(lv_coord_t)(root.x1+x),(lv_coord_t)(root.y1+y),(lv_coord_t)(root.x1+x+w-1),(lv_coord_t)(root.y1+y+h-1)};
  const lv_area_t *oldClip = ctx->clip_area;
  lv_area_t clip = {LV_MAX(cell.x1,oldClip->x1),LV_MAX(cell.y1,oldClip->y1),LV_MIN(cell.x2,oldClip->x2),LV_MIN(cell.y2,oldClip->y2)};
  if (clip.x1 > clip.x2 || clip.y1 > clip.y2) return;
  lv_draw_label_dsc_t d; lv_draw_label_dsc_init(&d);
  d.font = &lv_font_montserrat_14; d.color = lv_color_hex(color);
  d.flag = LV_TEXT_FLAG_EXPAND; d.align = center ? LV_TEXT_ALIGN_CENTER : LV_TEXT_ALIGN_LEFT;
  ctx->clip_area = &clip;
  lv_draw_label(ctx, &d, &cell, text, NULL);
  ctx->clip_area = oldClip;
}
extern "C" void can_scanner_draw_event(lv_event_t *event) {
  if (xoa != 88 || lv_event_get_target(event) != objects.screen_can_scanner) return;
  lv_draw_ctx_t *ctx = lv_event_get_draw_ctx(event);
  if (!ctx || !ctx->clip_area) return;
  lv_area_t root; lv_obj_get_coords(objects.screen_can_scanner, &root);
  scanner_box(ctx,root,96,0,384,320,0x091321);
  scanner_box(ctx,root,96,0,384,28,0x1B344E);
  const int widths[5] = {76,20,180,52,56};
  const char *headers[5] = {"ID","D","Data (Hex)","Cycle","Count"};
  int x=96;
  for (unsigned col=0;col<5;++col) { scanner_text(ctx,root,x+1,5,widths[col]-2,19,headers[col],0x91B4D4); x+=widths[col]; }
  for (unsigned v=0;v<SCANNER_VISIBLE_ROWS;++v) {
    unsigned row=(unsigned)scanner_top+v;
    int y=28+(int)v*30;
    if (root.y1+y+29 < ctx->clip_area->y1 || root.y1+y > ctx->clip_area->y2) continue;
    scanner_box(ctx,root,96,y,384,29,v&1 ? 0x102036 : 0x0B192B);
    if (row>=scanner_count) continue;
    const CAN_Storage &item=can_buffer[scanner_order[row]];
    char value[32]; x=96;
    for (unsigned col=0;col<5;++col) {
      if (col==0) snprintf(value,sizeof(value),item.extended ? "%08lX" : "%03lX",(unsigned long)item.id);
      else if (col==1) snprintf(value,sizeof(value),"%u",(unsigned)item.dlc);
      else if (col==2) {
        if (item.remote) strcpy(value,"RTR");
        else if (!item.dlc) strcpy(value,"-");
        else {
          unsigned used=0;
          for (unsigned b=0;b<item.dlc;++b) used+=(unsigned)snprintf(value+used,sizeof(value)-used,b?" %02X":"%02X",(unsigned)item.data[b]);
        }
      } else snprintf(value,sizeof(value),"%lu",(unsigned long)(col==3 ? item.cycle_time : item.count));
      scanner_text(ctx,root,x+1,y+6,widths[col]-2,20,value,col>=2&&item.highlighted ? 0xF5DA63 : 0x72E6B0);
      x+=widths[col];
    }
  }
  scanner_box(ctx,root,96,298,384,22,0x1B344E);
  char position[48];
  if (!scanner_count) strcpy(position,"Waiting for CAN...");
  else snprintf(position,sizeof(position),"%u-%u / %u%s",(unsigned)scanner_top+1,(unsigned)LV_MIN(scanner_top+(int)SCANNER_VISIBLE_ROWS,scanner_count),(unsigned)scanner_count,scanner_limit_reached?"+":"");
  scanner_text(ctx,root,102,300,372,20,position,0x91B4D4);
  scanner_box(ctx,root,8,12,80,42,0x1B344E);
  scanner_text(ctx,root,8,24,80,22,LV_SYMBOL_UP,scanner_top ? 0xFFFFFF : 0x56718B,true);
  scanner_box(ctx,root,8,150,80,42,0x1B344E);
  scanner_text(ctx,root,8,162,80,22,LV_SYMBOL_DOWN,scanner_top<scanner_max_top() ? 0xFFFFFF : 0x56718B,true);
  scanner_box(ctx,root,32,66,32,72,0x1B344E);
  int thumb=66+(scanner_max_top() ? scanner_top*52/scanner_max_top() : 0);
  scanner_box(ctx,root,32,thumb,32,20,0x2DD4BF);
}
void init_can_scanner() {
