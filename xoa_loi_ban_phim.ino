  Serial.println("[SCAN] native ready: no table/cell allocation");
}
int get_total_can_ids() { return scanner_count; }
void read_can_to_buffer() {
  const uint32_t started = micros();
  for (unsigned n = 0; n < SCANNER_RX_MAX_FRAMES; ++n) {
    if ((uint32_t)(micros() - started) >= SCANNER_RX_BUDGET_US) break;
    CanFrame frame = {};
    if (!ESP32Can.readFrame(frame, 0)) break; // Never wait for the next CAN frame.
    if (frame.data_length_code > 8 || frame.identifier > (frame.extd ? 0x1FFFFFFFu : 0x7FFu)) continue;
    int slot = -1;
    for (unsigned i = 0; i < scanner_count; ++i) {
      if (can_buffer[i].id == frame.identifier && can_buffer[i].extended == (bool)frame.extd) { slot = (int)i; break; }
    }
    bool fresh = slot < 0;
    if (fresh) {
      if (scanner_count == MAX_CAN_IDS) { scanner_limit_reached = true; continue; }
      slot = scanner_count;
      unsigned pos = 0;
      while (pos < scanner_count) {
        const CAN_Storage &other = can_buffer[scanner_order[pos]];
        if (other.id > frame.identifier || (other.id == frame.identifier && other.extended > (bool)frame.extd)) break;
        ++pos;
      }
      for (unsigned row = scanner_count; row > pos; --row) {
        scanner_order[row] = scanner_order[row - 1];
        can_buffer[scanner_order[row]].row = row;
      }
      scanner_order[pos] = (uint8_t)slot;
      can_buffer[slot].row = pos;
      can_buffer[slot].id = frame.identifier;
      can_buffer[slot].extended = (bool)frame.extd;
      ++scanner_count;
      // Mark only the sorted rows whose mapping changed; no copying of LVGL cells.
      scanner_dirty_rows |= ((UINT64_C(1) << scanner_count) - 1) & ~((UINT64_C(1) << pos) - 1);
    }
    CAN_Storage &item = can_buffer[slot];
    const uint32_t now = millis();
    uint8_t payload[8] = {};
    if (!frame.rtr) memcpy(payload, frame.data, frame.data_length_code);
    bool changed = fresh || item.dlc != frame.data_length_code || item.remote != (bool)frame.rtr || memcmp(item.data, payload, 8) != 0;
    if (!fresh) item.cycle_time = now - item.last_receive_time;
    if (item.count != UINT32_MAX) ++item.count;
    item.last_receive_time = now;
    item.dlc = frame.data_length_code;
    item.remote = (bool)frame.rtr;
    memcpy(item.data, payload, 8);
    if (changed) { item.last_change = now; item.highlighted = true; }
    scanner_dirty_rows |= UINT64_C(1) << item.row;
  }
}
void update_table_from_buffer() {
  const uint32_t now=millis();
  if ((uint32_t)(now-scanner_last_draw)<80) return;
  scanner_last_draw=now;
  for (unsigned i=0;i<scanner_count;++i) {
    CAN_Storage &item=can_buffer[i];
    if (item.highlighted && (uint32_t)(now-item.last_change)>=500) {
      item.highlighted=false; scanner_dirty_rows|=UINT64_C(1)<<item.row;
    }
  }
  // Invalidate only dirty visible rows, or the viewport after a scroll/new ID.
  lv_area_t root; lv_obj_get_coords(objects.screen_can_scanner,&root);
  if (scanner_view_dirty || scanner_shown_total!=scanner_count || scanner_shown_limit!=scanner_limit_reached) {
    lv_obj_invalidate(objects.screen_can_scanner);
  } else {
    for (unsigned v=0;v<SCANNER_VISIBLE_ROWS;++v) {
      unsigned row=(unsigned)scanner_top+v;
      if (row>=scanner_count) break;
      if (scanner_dirty_rows & (UINT64_C(1)<<row)) {
        lv_area_t area={(lv_coord_t)(root.x1+96),(lv_coord_t)(root.y1+28+v*30),(lv_coord_t)(root.x1+479),(lv_coord_t)(root.y1+57+v*30)};
        lv_obj_invalidate_area(objects.screen_can_scanner,&area);
      }
    }
  }
  scanner_dirty_rows=0; scanner_view_dirty=false;
  if ((scanner_shown_total!=scanner_count || scanner_shown_limit!=scanner_limit_reached) && objects.total_id_can_read) {
    lv_label_set_text_fmt(objects.total_id_can_read,scanner_limit_reached?"%u+":"%u",(unsigned)scanner_count);
    scanner_shown_total=scanner_count; scanner_shown_limit=scanner_limit_reached;
  }
}

