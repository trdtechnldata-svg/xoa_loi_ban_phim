void read_a1() {
  if (ESP32Can.readFrame(rxFrame, 11)) {
    if (rxFrame.identifier == 0x710) {
      int bit_0 = rxFrame.data[0];
      int bit_1 = rxFrame.data[1];
      volt_a1 = (word(bit_1, bit_0)) * 0.1;
    }
    if (rxFrame.identifier == 0x711) {
      soc_a1 = rxFrame.data[0];
    }
    if (rxFrame.identifier == 0x712) {
      t1_a1 = rxFrame.data[1];
      t2_a1 = rxFrame.data[2];
      t3_a1 = rxFrame.data[3];
      t4_a1 = rxFrame.data[4];
      t5_a1 = rxFrame.data[5];
    }
    if (rxFrame.identifier == 0x715) {
      t7_a1 = rxFrame.data[1];
      t6_a1 = rxFrame.data[0];
    }
    if (rxFrame.identifier == 0x716) {
      int bit_00 = rxFrame.data[0];
      int bit_01 = rxFrame.data[1];
      int bit_02 = rxFrame.data[2];
      int bit_03 = rxFrame.data[3];
      v_min_a1 = word(bit_01, bit_00) * 0.001;
      v_max_a1 = word(bit_03, bit_02) * 0.001;
      del_vol_a1 = v_max_a1 - v_min_a1;
    }
  }
}
