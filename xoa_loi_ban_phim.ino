void kich_hoat_read_data() {

  if ((unsigned long)(millis() - time_cho_2) > 50) {
    dem++;
    if (dem == 1)
      data10F[0] = 0x10;
    if (dem == 2)
      data10F[0] = 0x11;
    if (dem == 3)
      data10F[0] = 0x12;
    if (dem == 4)
      data10F[0] = 0x13;
    if (dem == 5)
      dem = 1;
    CanFrame obdFrame = { 0 };
    obdFrame.identifier = 0x101;  // Default OBD2 address;
    obdFrame.extd = 0;
    obdFrame.data_length_code = 8;
    obdFrame.data[0] = 0x00;
    obdFrame.data[1] = 0x10;
    obdFrame.data[2] = 0x00;
    //  obdFrame.data[3]          = 0x01; // Best use 0xAA (0b10101010) instead of 0
    ESP32Can.writeFrame(obdFrame);

    CanFrame newFrame = { 0 };
    newFrame.identifier = 0x10F;  // Default OBD2 address;
    newFrame.extd = 0;
    newFrame.data_length_code = 8;
    if (dem == 1)
      newFrame.data[0] = 0x10;
    if (dem == 2)
      newFrame.data[0] = 0x11;
    if (dem == 3)
      newFrame.data[0] = 0x12;
    if (dem == 4)
      newFrame.data[0] = 0x13;
    if (dem == 5)
      dem = 1;
    //           = 0x00;
    // newFrame.data[1]          = 0x00;
    // newFrame.data[2]          = 0x00;
    newFrame.data[3] = 0x01;  // Best use 0xAA (0b10101010) instead of 0
    ESP32Can.writeFrame(newFrame);

    // byte sndStat101  =  CAN0.sendMsgBuf(0x101, 0, 8, data101);
    // delay(50);
    // byte sndStat10F  =  CAN0.sendMsgBuf(0x10F, 0, 8, data10F);
    time_cho_2 = millis();
  }
}


