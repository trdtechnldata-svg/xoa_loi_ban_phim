void my_disp_flush(lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p) {
  if (jk_app_is_open()) {
    lv_disp_flush_ready(disp);
    return;
  }
  uint32_t w = (area->x2 - area->x1 + 1);
  uint32_t h = (area->y2 - area->y1 + 1);
  static uint8_t tracedFrames = 0;
  static uint32_t tracedPixels = 0, tracedBands = 0;
  static int16_t tracedBottom = -1;

  tft.startWrite();
  tft.setAddrWindow(area->x1, area->y1, w, h);
  tft.pushColors((uint16_t *)&color_p->full, w * h, true);
  tft.endWrite();

  // Trace only the first three refreshes, never per CAN data frame.
  if (tracedFrames < 3) {
    tracedPixels += w * h;
    tracedBands++;
    if (area->y2 > tracedBottom) tracedBottom = area->y2;
    if (lv_disp_flush_is_last(disp)) {
      Serial.printf("[DISPLAY] refresh=%u bands=%u pixels=%u bottom=%d\n",
                    (unsigned)tracedFrames,(unsigned)tracedBands,
                    (unsigned)tracedPixels,(int)tracedBottom);
      tracedFrames++;
      tracedPixels = tracedBands = 0; tracedBottom = -1;
    }
  }
  lv_disp_flush_ready(disp);
}

void my_touchpad_read(lv_indev_drv_t *indev_driver, lv_indev_data_t *data) {
  uint16_t touchX = 0, touchY = 0;

  bool touched = tft.getTouch(&touchX, &touchY, 600);
  if (jk_app_capture_touch(touchX, touchY, touched)) {
    data->state = LV_INDEV_STATE_REL;
    return;
  }
  if (charger1000_capture_touch(touchX, touchY, touched) ||
      can_scanner_capture_touch(touchX, touchY, touched)) {
    data->state = LV_INDEV_STATE_REL;
    return;
  }

  if (!touched) {
    data->state = LV_INDEV_STATE_REL;
  } else {
    data->state = LV_INDEV_STATE_PR;

    /*设置坐标*/
    data->point.x = touchX;
    data->point.y = touchY;

    // Serial.print("Data x ");
    // Serial.println(touchX);

    // Serial.print("Data y ");
    // Serial.println(touchY);
  }
}




