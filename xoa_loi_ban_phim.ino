void loop() {
  if (jk_app_is_open()) {
    jk_app_poll();
    delay(5);
    return; // Native JK exclusively owns TFT/touch; LVGL resumes after HOME.
  }
  charger1000_poll();
  if (charger1000_is_open()) {
    lv_timer_handler();
    delay(5);
    return; // Sole owner of CAN while the charger app is open.
  }

  lv_timer_handler();
  // An app may have been opened by this LVGL pass; skip all legacy CAN work.
  if (charger1000_is_open()) return;

  if (xoa == 88) {
    // Process pending BACK before any scanner work. All UI stays in this loop.
    ngat_timer();
    if (xoa == 88) {
      read_can_to_buffer();
      update_table_from_buffer();
    }
    delay(1);
    return;
  }
  if (xoa == 54) {

    btn_On1_event();
  }


  if (xoa == 24) {
    kich_hoat_pin_24();
    lv_scr_load(objects.main_24kw);
    read_data_pin_24();
    hien_thi_pin_24();
  }


  if ((unsigned long)(millis() - thoigian_2) > 1500) {
    for (int i = 0; i < 100; i++) {
      volpin = analogRead(batt_pin);
      volpin_2 = volpin + volpin_2;
    }

    volpin_3 = volpin_2 / 100;
    vol = volpin_3 / 600;                // LGT328p
                                         //  vol= volpin_3 /10.46422 ;
    phantram = (vol - 3.2) / 0.9 * 100;  //4 acquy  7.5 / 14s = -14  / 13s = -10
    // Serial.println( phantram );
    if (phantram >= 100) {
      phantram = 100;
    }
    if (phantram <= 1) {
      phantram = 0;
    }
    char _batt[32] = {};
    snprintf(_batt, sizeof(_batt), "%3d%%", phantram);
    lv_label_set_text(objects.batt_text, _batt);

    lv_bar_set_value(objects.batt_bar, phantram, LV_ANIM_OFF);
    volpin = 0;
    volpin_2 = 0;
    volpin_3 = 0;
    thoigian_2 = millis();
  }
  //  lv_obj_set_style_text_font(objects.text_bao_hanh, &font_vn_22, LV_PART_MAIN | LV_STATE_DEFAULT);

  ngat_timer();
  if (jk_app_is_open()) return;
  // lv_tick_inc(millis() - lastTick);  //Update the tick timer. Tick is new for LVGL 9
  // lastTick = millis();
  // lv_timer_handler();  //Update the UI
  //Used in https://youtu.be/uYh4BMK9QQ4
  //read_data();
  // hien_thi();
  if (xoa == 5) {
    lv_scr_load(objects.read_a1);
    kich_hoat_a1();
    read_a1();
    hien_thi_a1();
    //  Serial.println( "load ban phim");
  }
  if (xoa == 4) {
    lv_scr_load(objects.ban_phim);
  }
  if (xoa == 2)  //read_pin_lfp
  {

    main_read_data();
    read_data();  //read_pin_lfp
    hien_thi();
  }
  if (xoa == 3) {
    main_read_data();
    read_data_b1();
    hien_thi_b1();
  }
}
