void btn_Off_event() {


  // byte sndStat1022 = CAN0.sendMsgBuf(0x102, 0, 8, data1022); // tat xe
  data588[0] = 0x33;
  // byte sndStat102 = CAN0.sendMsgBuf(0x102, 0, 8, data102);
  rxFrame.identifier = (0x588);
  rxFrame.extd = 0;  // To enable extended ID.
  rxFrame.data_length_code = 1;
  for (int i = 0; i < rxFrame.data_length_code; i++) {
    rxFrame.data[i] = data588[i];
  }
  ESP32Can.writeFrame(rxFrame);
  delay(100);
  rxFrame.identifier = (0x583);
  rxFrame.extd = 0;  // To enable extended ID.
  rxFrame.data_length_code = 1;
  for (int i = 0; i < rxFrame.data_length_code; i++) {
    rxFrame.data[i] = data583[i];
  }
  ESP32Can.writeFrame(rxFrame);
  rxFrame.identifier = (0x750);
  rxFrame.extd = 0;  // To enable extended ID.
  rxFrame.data_length_code = 1;
  for (int i = 0; i < rxFrame.data_length_code; i++) {
    rxFrame.data[i] = data750[i];
  }
  ESP32Can.writeFrame(rxFrame);
  rxFrame.identifier = (0x751);
  rxFrame.extd = 0;  // To enable extended ID.
  rxFrame.data_length_code = 8;
  for (int i = 0; i < rxFrame.data_length_code; i++) {
    rxFrame.data[i] = data751[i];
  }
  ESP32Can.writeFrame(rxFrame);
